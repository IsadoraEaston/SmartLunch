@model IEnumerable<SmartLunch.Models.Child>
@using SmartLunch.Models
@{
    ViewData["Title"] = "Mes enfants";
}

<h1>Mes enfants</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Ajouter un enfant</a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Vous n'avez encore inscrit aucun enfant au service SmartLunch.
    </div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Prénom</th>
                <th>Nom</th>
                <th>Classe</th>
                <th>Allergies</th>
                <th>Préférences</th>
                <th>Statut</th>
                <th><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var child in Model)
            {
                <tr>
                    <td>@child.FirstName</td>
                    <td>@child.LastName</td>
                    <td>@child.ClassNumber</td>
                    <td>
                        @if (child.ChildAllergies.Any())
                        {
                            foreach (var ca in child.ChildAllergies)
                            {
                                <span class="badge bg-danger me-1">@ca.Allergy?.Name</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">Aucune</span>
                        }
                    </td>
                    <td>@(string.IsNullOrWhiteSpace(child.FoodPreferences) ? "—" : child.FoodPreferences)</td>
                                        <td>
                        @switch (child.Status)
                        {
                            case ChildStatus.Approved:
                                <span class="badge bg-success">Approuvé</span>
                                break;
                            case ChildStatus.Rejected:
                                <span class="badge bg-danger">Rejeté</span>
                                @if (!string.IsNullOrWhiteSpace(child.RejectionReason))
                                {
                                    <div class="small text-muted">@child.RejectionReason</div>
                                }
                                break;
                            default:
                                <span class="badge bg-warning text-dark">En attente</span>
                                break;
                        }
                    </td>
                    <td><a asp-action="Edit" asp-route-id="@child.Id" class="btn btn-sm btn-outline-primary">Modifier</a></td>
                </tr>
            }
        </tbody>
    </table>
}