@model SmartLunch.Models.ChildFormViewModel

@{
    ViewData["Title"] = "Ajouter un enfant";
}

<h1>Ajouter un enfant</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ClassNumber" class="form-label"></label>
                <input asp-for="ClassNumber" class="form-control" placeholder="E-31" />
                <span asp-validation-for="ClassNumber" class="text-danger"></span>
            </div>

            <fieldset class="mb-3">
                <legend class="form-label fs-6">Allergies alimentaires</legend>

                @if (!Model.AvailableAllergies.Any())
                {
                    <p class="text-muted">Aucune allergie n'est encore définie dans le système.</p>
                }

                @foreach (var allergy in Model.AvailableAllergies)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox"
                               id="allergy-@allergy.Id"
                               name="SelectedAllergyIds"
                               value="@allergy.Id"
                               checked="@Model.SelectedAllergyIds.Contains(allergy.Id)" />
                        <label class="form-check-label" for="allergy-@allergy.Id">@allergy.Name</label>
                    </div>
                }
            </fieldset>

            <div class="mb-3">
                <label asp-for="FoodPreferences" class="form-label"></label>
                <textarea asp-for="FoodPreferences" class="form-control" rows="3"
                          placeholder="Ex. : sans ketchup, sans fromage"></textarea>
                <span asp-validation-for="FoodPreferences" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Enregistrer</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
