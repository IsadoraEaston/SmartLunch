@using SmartLunch.Data
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartLunch</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartLunch.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">SmartLunch</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Accueil</a>
                        </li>

                        @if (User.IsInRole(IdentitySeeder.ParentRole))
                        {
                            @* Menu Parent : les liens seront branchés quand les pages de Doris existeront *@
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Children" asp-action="Index">Mes enfants</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Calendar" asp-action="Index">Calendrier</a>
                            </li>
                            <li class="nav-item">
                               <a class="nav-link text-dark" asp-controller="Contact" asp-action="Index">Contact</a>
                            </li>
                        }

                        @if (User.IsInRole(IdentitySeeder.AdministratorRole))
                        {
                            @* Menu Administrator : les liens seront branchés quand mes pages existeront *@
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Admin/Meals">Repas</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Admin/DailyMenus">Menus</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="#">Commandes du jour</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SmartLunch - <a asp-area="" asp-controller="Home" asp-action="Privacy">Confidentialité</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>