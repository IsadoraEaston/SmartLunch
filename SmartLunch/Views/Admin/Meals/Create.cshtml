@model SmartLunch.Models.Meal

@{
    ViewData["Title"] = "Ajouter un repas";
    var allergies = (List<SmartLunch.Models.Allergy>)ViewBag.Allergies;
    var selected = (HashSet<int>)ViewBag.SelectedAllergyIds;
}

<h1>Ajouter un repas</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post" action="/Admin/Meals/Create">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" max="100" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsVegetarian" class="form-check-input" />
                <label asp-for="IsVegetarian" class="form-check-label"></label>
            </div>

            <div class="mb-3">
                <label class="form-label">Allergènes contenus dans ce repas</label>
                @foreach (var allergy in allergies)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="allergyIds"
                               value="@allergy.Id" id="allergy-@allergy.Id"
                               checked="@selected.Contains(allergy.Id)" />
                        <label class="form-check-label" for="allergy-@allergy.Id">@allergy.Name</label>
                    </div>
                }
            </div>

            <button type="submit" class="btn btn-primary">Enregistrer</button>
            <a class="btn btn-secondary" href="/Admin/Meals">Annuler</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}