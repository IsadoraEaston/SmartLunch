@model SmartLunch.Models.DailyMenu

@{
    ViewData["Title"] = "Modifier le menu";
    var meals = (List<SmartLunch.Models.Meal>)ViewBag.Meals;
    var selected = (HashSet<int>)ViewBag.SelectedMealIds;
}

<h1>Menu du @Model.Date.ToString("dddd d MMMM yyyy")</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post" action="/Admin/DailyMenus/Edit/@Model.Id">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="isClosed" value="true"
                       id="isClosed" checked="@Model.IsClosed" />
                <label class="form-check-label" for="isClosed">Journée fermée (journée pédagogique, etc.)</label>
            </div>

            <div class="mb-3">
                <label class="form-label" for="closedReason">Raison de la fermeture</label>
                <input class="form-control" type="text" name="closedReason" id="closedReason"
                       maxlength="200" value="@Model.ClosedReason" />
            </div>

            <div class="mb-3">
                <label class="form-label">Choisir exactement 3 repas (si la journée est ouverte)</label>
                @foreach (var meal in meals)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="mealIds"
                               value="@meal.Id" id="meal-@meal.Id"
                               checked="@selected.Contains(meal.Id)" />
                        <label class="form-check-label" for="meal-@meal.Id">
                            @meal.Name (@meal.Price.ToString("C"))
                        </label>
                    </div>
                }
            </div>

            <button type="submit" class="btn btn-primary">Enregistrer</button>
            <a class="btn btn-secondary" href="/Admin/DailyMenus">Annuler</a>
        </form>
    </div>
</div>