@{
    ViewData["Title"] = "Ajouter une journée";
}

<h1>Ajouter une journée</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post" action="/Admin/DailyMenus/Create">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label class="form-label" for="date">Date</label>
                <input class="form-control" type="date" name="date" id="date" required />
            </div>

            <p class="text-muted">
                Après l'enregistrement, vous choisirez les 3 repas de cette journée.
            </p>

            <button type="submit" class="btn btn-primary">Continuer</button>
            <a class="btn btn-secondary" href="/Admin/DailyMenus">Annuler</a>
        </form>
    </div>
</div>